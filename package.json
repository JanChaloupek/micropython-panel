{
  "name": "micropython-panel",
  "displayName": "MicroPython & CircuitPython Panel",
  "description": "Tlačítka a panel pro práci s deskami s MicroPythonem a CircuitPythonem (nahrání, REPL, soubory, připojené desky).",
  "publisher": "JanChaloupek",
  "version": "0.3.1",

  "repository": {
    "type": "git",
    "url": "https://github.com/JanChaloupek/micropython-panel.git"
  },

  "engines": {
    "vscode": "^1.80.0"
  },

  "main": "./src/extension.js",

  "activationEvents": [
    "workspaceContains:**/main.py",
    "workspaceContains:**/code.py",
    "workspaceContains:**/boot.py",
    "workspaceContains:**/.vscode/deska.py"
  ],

  "contributes": {
    "commands": [
      {
        "command": "micropython.openPanel",
        "title": "MicroPython & CircuitPython: Open Panel"
      },
      {
        "command": "micropython.showCommands",
        "title": "MicroPython & CircuitPython: Commands"
      },
      {
        "command": "micropython.refreshDevices",
        "title": "MicroPython & CircuitPython: Refresh Devices"
      }
    ],

    "viewsContainers": {
      "activitybar": [
        {
          "id": "micropython",
          "title": "MicroPython & CircuitPython",
          "icon": "media/micropython-icon.svg"
        }
      ]
    },

    "views": {
      "micropython": [
        {
          "type": "webview",
          "id": "micropython.sidebarPanel",
          "name": "Panel",
          "when": "micropython.boardProject"
        }
      ]
    },

    "menus": {
      "commandPalette": [
        { "command": "micropython.openPanel", "when": "micropython.boardProject" },
        { "command": "micropython.showCommands", "when": "micropython.boardProject" },
        { "command": "micropython.refreshDevices", "when": "micropython.boardProject" }
      ]
    },

    "configuration": {
      "title": "MicroPython & CircuitPython Panel",
      "properties": {
        "micropython.enableStatusToolbar": {
          "type": "boolean",
          "default": true,
          "description": "Zobrazit tlačítka ve stavovém řádku (jen ta, která nemají statusBar: false)."
        },

        "micropython.autoOpenPanel": {
          "type": "boolean",
          "default": true,
          "description": "Po restartu VS Code znovu otevřít panel v editoru, pokud byl otevřený."
        },

        "micropython.commands": {
          "type": "array",
          "description": "Tlačítka panelu a stavového řádku. Každé tlačítko spustí svůj příkaz v terminálu.",
          "default": [],
          "items": {
            "type": "object",
            "required": ["id", "name", "command"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Jedinečný identifikátor (bez mezer a diakritiky)."
              },
              "name": {
                "type": "string",
                "description": "Text tlačítka ve stavovém řádku a v rychlém menu. Může obsahovat ikonu VS Code, např. $(play)."
              },
              "label": {
                "type": "string",
                "description": "Text tlačítka v panelu (výchozí = name)."
              },
              "command": {
                "type": "string",
                "description": "Příkaz, který se spustí v terminálu."
              },
              "color": {
                "type": "string",
                "description": "Barva textu a proužku tlačítka (název CSS barvy nebo #rrggbb)."
              },
              "group": {
                "type": "string",
                "description": "Blok v panelu (např. MicroPython, CircuitPython)."
              },
              "platform": {
                "type": "string",
                "enum": ["micropython", "circuitpython"],
                "description": "Které desky blok ukazuje. Když žádná taková deska není připojená, blok se ztlumí."
              },
              "statusBar": {
                "type": "boolean",
                "default": true,
                "description": "false = tlačítko jen v panelu, ne ve stavovém řádku."
              },
              "confirm": {
                "type": "string",
                "description": "Otázka v modálním dialogu před spuštěním (pro nevratné akce, např. smazání desky). Při zrušení se nic nespustí."
              },
              "confirmButton": {
                "type": "string",
                "description": "Text potvrzovacího tlačítka v dialogu (výchozí „Pokračovat“)."
              }
            }
          }
        },

        "micropython.devicesCommand": {
          "type": "string",
          "default": "",
          "description": "Příkaz, který vypíše připojené desky jako JSON (např. python .vscode/deska.py devices --json). Prázdný = v projektu s .vscode/deska.py se použije ten, jinak se seznam desek nezobrazí."
        },

        "micropython.devicesRefreshSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Jak často obnovovat seznam desek, když je panel vidět (v sekundách, 0 = jen ručně tlačítkem ↻)."
        }
      }
    }
  }
}
